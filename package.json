{
  "name": "timeclock",
  "version": "1.0.0",
  "private": true,
  "description": "Embeddable clock-in/out widget + HRIS-agnostic time service",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "tsx apps/api/src/server.ts",
    "test": "tsx tests/smoke.test.ts",
    "test:scheduling": "tsx tests/scheduling.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "docker:build": "docker build -t timeclock:latest .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env timeclock:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "tsx": "^4.19.2"
  }
}
