# Time-clock service configuration (all optional for the local demo).

# Display name for this deployment/instance (branding in the UI + tenant name).
# e.g. a per-customer instance:
# INSTANCE_NAME=Housing Counselors

# Port for the API + widget/supervisor UI (default 8787).
PORT=8787

# --- Persistence driver (ADR 0001) ---
# memory    in-process, volatile (default; dev/demo — resets on restart)
# postgres  durable: in-memory projection + write-through to Postgres via Prisma,
#           hydrated on boot. Requires DATABASE_URL + `npm run prisma:generate` and
#           the tables created (`npm run prisma:migrate`). See
#           apps/api/src/store/postgres/README.md.
# embedded  self-contained durable (PGlite/SQLite) — planned.
STORE_DRIVER=memory
# DATABASE_URL=postgres://user:pass@host:5432/timeclock   # required when STORE_DRIVER=postgres

# Host identity JWT + webhook signing secrets (demo defaults are used if unset).
TIMECLOCK_IDENTITY_SECRET=909ffc3d73b28dddb933f6856c1b3fe0c01dd07a22683829d3b9d7948f49565e
TIMECLOCK_WEBHOOK_SECRET=045b8ceac457c7468a36f010a1855f50f00b1b2ac8172387fa9281f5a0ca6255

# --- Forecast summary provider (the "AI" narration on the supervisor board) ---
# With NO key set, the forecast uses the deterministic `templateSummary` — the
# board still renders, no network, same input → same sentence.
# Set a key to have Claude write the morning read (ranking + phrasing only; it
# never recomputes the wage-and-hour numbers). Falls back to the template on any
# error. The on-demand "Recheck coverage & overtime" button uses the provider;
# the background worker always uses the deterministic template.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5   # default; override e.g. claude-haiku-4-5 for speed/cost
